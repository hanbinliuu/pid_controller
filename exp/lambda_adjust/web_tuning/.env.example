# ============================================
# AI助手配置 (可选)
# ============================================
# 如果不需要AI功能，可以不创建.env文件

# OpenAI API配置
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_BASE=https://api.openai.com/v1

# 或使用其他兼容OpenAI API的服务
# DeepSeek示例:
# OPENAI_API_KEY=your_deepseek_api_key
# OPENAI_API_BASE=https://api.deepseek.com/v1

# 使用说明:
# 1. 复制此文件为 .env
# 2. 填入你的API密钥
# 3. 重启后端服务
# 4. AI功能将自动启用
