# ==================== 数据库配置 ====================
# PostgreSQL 数据库连接配置
DB_HOST=192.168.201.113
DB_PORT=15432
DB_USER=postgres
DB_PASSWORD='Postgres#7556'
DB_NAME=pid_controller

# 或者直接设置完整的数据库URL（优先级高于上面的分开配置）
# DATABASE_URL=postgresql://postgres:postgres@192.168.201.113:15432/pid_controller

# SQLite 数据库连接URL (开发/测试用)
# DATABASE_URL=sqlite:///./database.db

# SQL调试开关（生产环境应设为false）
SQL_ECHO=false

# 数据库连接池配置
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ==================== 日志配置 ====================
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# ==================== TSDB配置 ====================
USE_REAL_TSDB=false
TSDB_BASE_URL=http://tsdb-select-infra-system.sit-cloud.ieccloud.hollicube.com
TSDB_TIMEOUT=30
TSDB_MAX_RETRIES=3
# TSDB_AUTH_TOKEN=your_token_here
DEFAULT_TSDB_DATABASE=platform

# ==================== 模拟数据配置 ====================
SIMULATION_DATA_DIR=data/simulated

# ==================== 工作流代理配置 ====================
WORKFLOW_BASE_URL=http://192.168.202.172
WORKFLOW_TOKEN=app-ZJxenSh1D9uFCqnGO7Dt917p
WORKFLOW_TIMEOUT=120
WORKFLOW_CONNECT_TIMEOUT=30
WORKFLOW_READ_TIMEOUT=300
HEALTH_CHECK_TIMEOUT=10

# ==================== BFF模型查询配置 ====================
BFF_MODEL_BASE_URL=http://bff-model-product-infra-system.sit-cloud.ieccloud.hollicube.com
BFF_MODEL_TIMEOUT=30
BFF_MODEL_LOOP_PATH=/pid_zd/0b521c82a96d4107a564e4c2678bdeca
BFF_MODEL_POINT_PATH=/loop_state_parameters

# ==================== 定时任务配置 ====================
# 是否启用回路性能计算定时任务
ENABLE_LOOP_PERFORMANCE_TASK=true

# 回路性能计算任务1的Cron表达式 (分 小时 天 月 周)
# 默认每小时执行一次
LOOP_PERFORMANCE_CRON=0 * * * *

# 定时任务的并行计算线程数 (推荐5-10)
TASK_MAX_WORKERS=5
